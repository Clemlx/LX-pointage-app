          case 8: // com.lxcommissioning.app.data.repository.NoteRepository 
          return (T) new NoteRepository(singletonCImpl.noteDao());

          case 9: // com.lxcommissioning.app.data.repository.PhotoRepository 
          return (T) new PhotoRepository(singletonCImpl.photoDao());

          default: throw new AssertionError(id);
        }
      }
    }
  }
}
